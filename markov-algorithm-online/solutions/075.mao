// Convert to "o"s
|          |:oooooooooo
|         |:ooooooooo
|        |:oooooooo
|       |:ooooooo
|      |:oooooo
|     |:ooooo
|    |:oooo
|   |:ooo
|  |:oo
| |:o
||:

// Clear
oX:X
,X:X
Xo:X
X,:X
X!:E
X:E

// Carry one from each element to the end
>,:X
>!:X!
>o:}
>:X!
}o:o}
},:,>
}!:!a
}:!a

// Convert back to spaces
Eaaaaaaaaaa::|          |
Eaaaaaaaaa::|         |
Eaaaaaaaa::|        |
Eaaaaaaa::|       |
Eaaaaaa::|      |
Eaaaaa::|     |
Eaaaa::|    |
Eaaa::|   |
Eaa::|  |
Ea::| |
E::||

